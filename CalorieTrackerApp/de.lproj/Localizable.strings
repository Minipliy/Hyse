"info.portions.title" = "Portionsauswahl";
"info.portions.body" = "Wähle links die ganzen Portionen und rechts einen zusätzlichen Bruchteil. Hyse addiert beide Werte und berechnet daraus Gramm, Kalorien und Nährwerte.";
"info.food_search.body" = "Die Suche prüft zuerst lokal gespeicherte und zuletzt verwendete Lebensmittel und ergänzt bei Bedarf Ergebnisse aus dem Hyse-Katalog. Über das Barcode-Symbol kannst du direkt scannen.";
"info.recipe_search.body" = "Hier werden deine eigenen und verfügbaren geteilten Rezepte durchsucht. Rezepte und Lebensmittel bleiben getrennt, damit die Ergebnisse übersichtlich bleiben.";
"info.calorie_balance.body" = "Die Kalorienbilanz zeigt dein Tagesziel abzüglich gegessener Kalorien und berücksichtigt – abhängig von deinen Einstellungen – verfügbare Aktivitätsdaten. Unter Details findest du die vollständige Berechnung.";
"info.nutrition_metric.general" = "Der erste Wert ist deine bisher eingetragene Menge, der zweite dein persönlicher Tagesorientierungswert. Die Werte sind Orientierung und keine medizinische Diagnose.";
"info.hydration.body" = "Die Trinkmenge wird lokal gespeichert. Wenn du Apple Health verbunden hast, überträgt Hyse deine eingetragenen Wassermengen zusätzlich dorthin.";
"info.steps.body" = "Die Schritte stammen aus Apple Health. Sie werden nur angezeigt, wenn du Hyse den entsprechenden Health-Zugriff erlaubt hast.";
"info.fasting.body" = "Der Fastentimer zählt ab deinem Startzeitpunkt bis zum gewählten Fastenziel. Beende das Fasten manuell, damit die Sitzung im Verlauf gespeichert wird.";

"info.health.connection" = "Apple Health verbindet Körpergewicht, Schritte, Energie- und weitere freigegebene Gesundheitsdaten mit Hyse. Du bestimmst die Berechtigungen jederzeit in der Health-App.";
"info.health.weight" = "Der Gewichtsgraph kombiniert Einträge aus Hyse und Apple Health. Alle Zeiträume zeigen die einzelnen Messwerte. Tippe oder ziehe über den Graphen, um Gewicht und Datum zu sehen.";
"info.health.nutrition" = "Diese Übersicht fasst die Ernährung des ausgewählten Tages aus deinen Hyse-Tagebucheinträgen zusammen.";
"info.health.training" = "Der Verlauf zeigt abgeschlossene Workouts pro Kalenderwoche einschließlich der laufenden Woche. Trainingstage zählen Tage mit mindestens einem Workout.";
"info.health.steps" = "Die Schritte kommen aus Apple Health. Der Durchschnitt berücksichtigt nur Tage mit mindestens einem Schritt, da Tage ohne Daten nicht zuverlässig von Tagen mit null Schritten unterscheidbar sind.";
"info.health.week" = "Die Wochenwerte fassen deine Trainingseinheiten seit Wochenbeginn zusammen. Aktive Energie wird aus Apple Health übernommen, sofern freigegeben.";

"info.training.feed" = "Im Trainingsfeed siehst du deine abgeschlossenen Workouts und die öffentlichen Workouts deiner Freunde. Private Workouts sind nur für dich sichtbar.";
"info.training.routines" = "Routinen speichern Übungen, Reihenfolge, Satzvorgaben und Pausenzeiten. Änderungen werden zuerst lokal gespeichert und später synchronisiert.";
"info.training.suggested_routines" = "Hyse-Vorschläge sind Vorlagen für bekannte Trainingsaufteilungen. Öffne einen Plan, prüfe die enthaltenen Tage und übernimm nur die Routinen, die zu dir passen.";
"info.training.recent_workouts" = "Hier erscheinen deine zuletzt abgeschlossenen Workouts. Öffne einen Eintrag für Sätze, Volumen, Rekorde und weitere Details.";
"info.training.profile_chart" = "Das Diagramm fasst Dauer, Volumen oder Wiederholungen je Woche zusammen. Tippe auf einen Balken, um den genauen Wert und das Datum anzuzeigen.";
"info.training.statistics" = "Die Statistik wird aus deinen lokal gespeicherten abgeschlossenen Workouts berechnet. Aufwärmsätze und unterschiedliche Übungstypen werden passend zu ihrer Bedeutung ausgewertet.";
"info.training.rpe" = "RPE beschreibt die subjektive Anstrengung eines Satzes von 5 bis 10. RPE 10 bedeutet, dass keine weitere saubere Wiederholung möglich gewesen wäre.";
"info.training.exercise_progress" = "Wähle Kennzahl, Einheit und Zeitraum. Tippe oder ziehe auf dem Graphen, um einen genauen Messpunkt zu sehen; lange Zeiträume werden für eine flüssige Darstellung gebündelt.";

"info.settings.account" = "Verwalte Profilbild, E-Mail, Passwort und Anmeldung. Deine Daten bleiben lokal verfügbar und werden bei bestehender Verbindung mit deinem Hyse-Konto synchronisiert.";
"info.settings.interests" = "Lege fest, ob du Ernährung, Training oder beide Bereiche in Hyse nutzen möchtest. Die unteren Tabs werden entsprechend ein- oder ausgeblendet.";
"info.settings.goals" = "Lege Nährwertziele fest, passe die Startseite an und verwalte deine Mahlzeiten.";
"info.settings.appearance" = "Passe Sprache, Design und Anzeigeeinheiten an. Gewicht, Flüssigkeit und Trainingsdistanz werden automatisch in die ausgewählte Einheit umgerechnet.";
"info.settings.health" = "Verbinde Hyse freiwillig mit Apple Health und verwalte den Austausch unterstützter Gesundheitsdaten.";
"info.settings.notifications" = "Bestimme, welche Motivation und Tagebucherinnerungen du erhältst. iOS kann Benachrichtigungen zusätzlich systemweit blockieren.";
"info.settings.training" = "Passe Pausenton, Lautstärke, Haptik und die Live-Aktivität für laufende Workouts an.";
"info.settings.content" = "Wähle, welche Bereiche auf deiner Ernährungsstartseite erscheinen, und verwalte deine Mahlzeiten.";
"info.settings.privacy" = "Hier findest du Einwilligungen, Datenschutz, AGB, Datenexport und die Möglichkeit, das interaktive Tutorial erneut zu starten.";
"info.settings.about" = "Informationen über Hyse, den Ernährungs- und Trainingstracker sowie offizielle Kanäle und rechtliche Dokumente.";
