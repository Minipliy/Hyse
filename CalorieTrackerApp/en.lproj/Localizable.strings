"info.recipe_search.body" = "This searches your own recipes and available shared recipes. Recipes and foods stay separate so the results remain clear.";
"info.calorie_balance.body" = "The calorie balance shows your daily target minus logged calories and can include available activity data depending on your settings. Open Details for the full calculation.";
"info.nutrition_metric.general" = "The first value is the amount logged so far and the second is your personal daily reference. These values are guidance and not a medical diagnosis.";
"info.hydration.body" = "Water intake is saved locally. When Apple Health is connected, Hyse also writes your logged water amounts to Health.";
"info.steps.body" = "Steps come from Apple Health and are shown only when you have granted Hyse the corresponding Health permission.";
"info.fasting.body" = "The fasting timer counts from your start time to the selected target. End the fast manually so the session is saved to your history.";

"info.health.connection" = "Apple Health connects body weight, steps, energy, and other permitted health data with Hyse. You can manage permissions in the Health app at any time.";
"info.health.weight" = "The weight chart combines entries from Hyse and Apple Health. Every range shows the individual measurements. Tap or drag across the chart to see the weight and date.";
"info.health.nutrition" = "This overview summarizes nutrition from your Hyse diary entries for the selected day.";
"info.health.training" = "The chart shows completed workouts per calendar week, including the current week. Training days count days with at least one workout.";
"info.health.steps" = "Steps come from Apple Health. The average includes only days with at least one step because days without data cannot reliably be distinguished from days with zero steps.";
"info.health.week" = "Weekly values summarize workouts since the start of the week. Active energy comes from Apple Health when permission is granted.";

"info.training.feed" = "The workout feed shows your completed workouts and public workouts from your friends. Private workouts are visible only to you.";
"info.training.routines" = "Routines save exercises, their order, set targets, and rest times. Changes are stored locally first and synchronized later.";
"info.training.suggested_routines" = "Hyse suggestions are templates for established training splits. Open a program, review its days, and import only the routines that suit you.";
"info.training.recent_workouts" = "Your latest completed workouts appear here. Open one to view sets, volume, records, and further details.";
"info.training.profile_chart" = "The chart summarizes duration, volume, or repetitions by week. Tap a bar to see its exact value and date.";
"info.training.statistics" = "Statistics are calculated from completed workouts stored locally. Warm-up sets and different exercise types are evaluated according to their purpose.";
"info.training.rpe" = "RPE describes the perceived effort of a set from 5 to 10. RPE 10 means another clean repetition would not have been possible.";
"info.training.exercise_progress" = "Choose the metric, unit, and range. Tap or drag across the chart for an exact point; longer ranges are grouped for smooth interaction.";

"info.settings.account" = "Manage your profile image, email, password, and sign-in. Data remains available locally and synchronizes with your Hyse account when connected.";
"info.settings.interests" = "Choose whether you want to use nutrition, training, or both in Hyse. The bottom tabs will appear accordingly.";
"info.settings.goals" = "Set nutrition goals, customize the home screen, and manage your meals.";
"info.settings.appearance" = "Adjust language, appearance, and display units. Weight, liquids, and training distance are converted automatically.";
"info.settings.health" = "Optionally connect Hyse with Apple Health and manage the exchange of supported health data.";
"info.settings.notifications" = "Choose which motivation and diary reminders you receive. iOS can additionally block notifications at system level.";
"info.settings.training" = "Adjust the rest sound, volume, haptics, and Live Activity for active workouts.";
"info.settings.content" = "Choose which sections appear on the nutrition home screen and manage your meals.";
"info.settings.privacy" = "Find consent choices, privacy information, terms, data export, and the option to replay the interactive tutorial.";
"info.settings.about" = "Information about Hyse, its nutrition and workout trackers, official channels, and legal documents.";
