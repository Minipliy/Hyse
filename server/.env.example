# Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die Datei ".env" bleibt auf deinem Server und gehört nicht ins Git-Repository.

# Deine Domain ohne https:// (muss per DNS auf deinen Server zeigen).
HYSE_DOMAIN=hyse.deine-domain.de

# Dieselbe Adresse mit https:// – wird in E-Mails und geteilten Links verwendet.
HYSE_PUBLIC_URL=https://hyse.deine-domain.de

# Absender für E-Mails und Kontaktadresse in E-Mails.
HYSE_SENDER_EMAIL=du@deine-domain.de
HYSE_CONTACT_EMAIL=du@deine-domain.de

# Optional, nur für den geschützten E-Mail-Versand an Nutzer. Leer lassen, wenn du ihn nicht brauchst.
HYSE_EMAIL_ADMIN_TOKEN=

# Optional für Universal Links: Team-ID und Bundle-ID deiner App, durch einen Punkt getrennt.
HYSE_APPLE_APP_ID=ABCDE12345.com.deinname.hyse
